Options -MultiViews
RewriteEngine On

# Canonical host + HTTPS in a SINGLE hop.
# Sends http://, www.duonoxx.com, and the old *.hostingersite.com URL all to
# https://duonoxx.com/... with one 301 (no redirect chains, which leak link equity).
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^duonoxx\.com$ [NC]
RewriteRule ^ https://duonoxx.com%{REQUEST_URI} [L,R=301]

# 301 redirect any old .html URL to its clean version (preserves SEO / old links)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /index -> /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Internally serve the .html file for the clean URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Custom error page (returns a true 404 status, not a soft-404 homepage).
# The .html -> clean-URL rule above matches on THE_REQUEST (the original browser
# request line), so this internal call to /404.html will not be redirected.
ErrorDocument 404 /404.html

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
